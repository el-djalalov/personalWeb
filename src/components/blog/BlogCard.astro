---
import type { CollectionEntry } from "astro:content";
import { buildLangUrl, getLangFromUrl } from "@/i18n";
import type { Language } from "@/content.config";
import { getPublicImageSize } from "@/utils/publicImageSize";

interface Props {
  post: CollectionEntry<"blog">;
  readingTime: string;
  lang?: Language;
}

const { post, readingTime, lang: propLang } = Astro.props;
const lang = propLang || getLangFromUrl(Astro.url);
const { title, description, pubDate, heroImage, tags, translationKey } = post.data;

// Use translationKey if available, otherwise fall back to post.id (without extension)
const postId = post.id.replace(/\.(md|mdx)$/, '');
const postSlug = translationKey || postId;

const heroSize = await getPublicImageSize(heroImage);
const dateLocales = { en: "en-US", uz: "uz-UZ", ru: "ru-RU" };
const formattedDate = pubDate.toLocaleDateString(dateLocales[lang] || "en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});

---

<article lang={post.data.lang !== lang ? post.data.lang : undefined} class="group relative flex flex-col h-full overflow-hidden rounded-xl border border-border bg-card transition-all duration-300 hover:shadow-xl hover:shadow-acc/10 hover:border-acc/50">
  <!-- Image -->
  <a href={buildLangUrl(`/blog/${postSlug}`, lang)} class="relative aspect-video overflow-hidden" tabindex="-1" aria-hidden="true">
    {heroImage ? (
      <img
        src={heroImage}
        alt=""
        width={heroSize?.width}
        height={heroSize?.height}
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        transition:name={`blog-hero-${post.id}`}
      />
    ) : (
      <div
        class="w-full h-full bg-linear-to-br from-acc/10 to-acc2/10 flex items-center justify-center"
        transition:name={`blog-hero-${post.id}`}
      >
        <svg class="w-12 h-12 text-acc/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
        </svg>
      </div>
    )}

    <!-- Gradient overlay -->
    <div class="absolute inset-0 bg-linear-to-t from-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
  </a>

  <!-- Content -->
  <div class="flex flex-col flex-1 p-5">
    <!-- Tags -->
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-3">
        {tags.slice(0, 3).map((tag) => (
          <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-acc/10 text-acc">
            {tag}
          </span>
        ))}
        {tags.length > 3 && (
          <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-secondary text-muted-foreground">
            +{tags.length - 3}
          </span>
        )}
      </div>
    )}

    <!-- Title -->
    <h2
      class="text-lg font-semibold text-foreground mb-2 line-clamp-2 group-hover:text-acc transition-colors"
      transition:name={`blog-title-${post.id}`}
    >
      <a href={buildLangUrl(`/blog/${postSlug}`, lang)} class="before:absolute before:inset-0">
        {title}
      </a>
    </h2>

    <!-- Description -->
    <p class="text-sm text-muted-foreground line-clamp-2 mb-4 flex-1">
      {description}
    </p>

    <!-- Meta -->
    <div class="flex items-center justify-between text-xs text-muted-foreground pt-4 border-t border-border">
      <time datetime={pubDate.toISOString()} class="flex items-center gap-1">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        {formattedDate}
      </time>
      <span class="flex items-center gap-1">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        {readingTime}
      </span>
    </div>
  </div>
</article>
