---
// The whole home page. Both src/pages/index.astro (English) and
// src/pages/[lang]/index.astro (Uzbek, Russian) render this component.
import { Image } from "astro:assets";
import myImage from "@/assets/images/AvatarMe.webp";
import DownloadButton from "@/components/home/DownloadButton.astro";
import { FEATURES } from "@/config";
import Projects from "@/components/projects";
import Contact from "@/components/contact/contact.astro";
import ExperienceSection from "@/components/experience/ExperienceSection";
import BlogPreview from "@/components/blog/BlogPreview.astro";
import { t } from "@/i18n";
import type { Language } from "@/content.config";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
---

<section id="top" class="relative">
  <div
    class="relative z-20 mx-auto flex max-w-6xl flex-col-reverse items-center justify-between gap-8 px-4 md:mt-14 md:flex-row"
  >
    <div class="flex flex-1 flex-col items-center justify-center gap-4 md:items-start md:justify-start">
      <h1 class="mb-3 pb-2 text-center text-5xl font-bold !leading-tight sm:text-6xl md:text-left md:text-8xl">
        {t("hero.greeting", lang)}
      </h1>
      <p class="mb-8 text-xl font-semibold text-muted-foreground md:mb-10">
        {t("hero.title", lang)}
      </p>
      {FEATURES.resumeDownload && <DownloadButton lang={lang} />}
    </div>
    <div class="relative z-30 w-56 px-2 md:w-80">
      <Image
        quality={"high"}
        alt={t("hero.portraitAlt", lang)}
        src={myImage}
        widths={[208, 320, 416, 640]}
        sizes="(min-width: 768px) 320px, 208px"
        loading="eager"
        fetchpriority="high"
        class="relative mx-auto w-80"
      />
    </div>
  </div>
</section>

<ExperienceSection lang={lang} />
<Projects client:visible lang={lang} />
<BlogPreview lang={lang} />
<Contact lang={lang} />
