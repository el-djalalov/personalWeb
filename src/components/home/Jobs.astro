---
import { getExperiences } from "@/i18n";
import type { HomeCopy } from "@/i18n/home";
import type { Language } from "@/content.config";

interface Props {
  lang: Language;
  copy: HomeCopy["jobs"];
}

const { lang, copy } = Astro.props;
const jobs = getExperiences(lang);
// The freelance years point at this site; no need to link it to itself
const external = (url: string) => !url.includes("elyor.dev");
---

<section id="jobs" class="mx-auto max-w-6xl px-4 pt-20">
  <!-- Old links to /#experience still land here -->
  <span id="experience" aria-hidden="true"></span>
  <div class="mb-6 flex flex-wrap items-baseline justify-between gap-3">
    <h2 class="font-display text-[clamp(1.6rem,3.4vw,2.25rem)] font-bold tracking-tight">{copy.title}</h2>
    <span class="font-mono text-xs text-muted-foreground">{copy.hint}</span>
  </div>
  <ol class="border-t border-border">
    {
      jobs.map(job => (
        <li
          class:list={[
            // -mx/px: the hover background reaches past the text, the text stays in line with the heading
            "group relative -mx-3 grid gap-x-6 gap-y-2 border-b border-border px-3 py-4 md:grid-cols-[13rem_1fr_auto] md:items-center",
            external(job.website) && "transition-colors duration-200 hover:bg-acc/10",
          ]}
        >
          <span class="font-mono text-xs tabular-nums text-muted-foreground">{job.dates}</span>
          <span class="flex items-center gap-3 font-semibold">
            <!-- White tile: most logos are made for a light background -->
            <img
              src={job.logo}
              alt=""
              width="32"
              height="32"
              loading="lazy"
              decoding="async"
              class="h-8 w-8 flex-none rounded-lg bg-white object-contain p-1 ring-1 ring-border transition-transform duration-300 ease-site group-hover:scale-110"
            />
            {job.role}
          </span>
          {external(job.website) ? (
            // after:inset-0 stretches the link over the whole row, so the row is one click target
            <a
              href={job.website}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-muted-foreground transition-colors after:absolute after:inset-0 focus-visible:outline-hidden focus-visible:after:outline-solid focus-visible:after:outline-2 focus-visible:after:-outline-offset-2 focus-visible:after:outline-acc group-hover:text-acc"
            >
              {job.company}{" "}
              <span
                aria-hidden="true"
                class="inline-block transition-transform duration-300 ease-site group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
              >
                ↗
              </span>
            </a>
          ) : (
            <span class="text-sm text-muted-foreground">{job.company}</span>
          )}
        </li>
      ))
    }
  </ol>
</section>
