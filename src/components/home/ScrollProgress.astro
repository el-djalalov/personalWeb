---
// Page scroll progress bar, driven by CSS scroll-driven animations (no JS).
// Decorative, so it's hidden from assistive technology; browsers without
// scroll timelines simply don't show it.
---

<div class="scroll-progress" aria-hidden="true"></div>

<style>
  .scroll-progress {
    display: none;
  }

  @supports (animation-timeline: scroll()) {
    .scroll-progress {
      display: block;
      position: fixed;
      inset: 0 0 auto 0;
      z-index: 100;
      height: 0.25rem;
      transform-origin: left;
      background-image: linear-gradient(to right, #06b6d4, #d946ef, #3b82f6);
      animation: grow-progress linear both;
      /* After the shorthand, which would otherwise reset it */
      animation-timeline: scroll(root block);
    }
  }

  @keyframes grow-progress {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
</style>
