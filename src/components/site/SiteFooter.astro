---
import { getLangFromUrl } from "@/i18n";
import { CONTACT, getSiteCopy } from "@/i18n/site";

const lang = getLangFromUrl(Astro.url);
const copy = getSiteCopy(lang);
const year = new Date().getFullYear();

const links = [
  { label: "Telegram", href: CONTACT.telegramChannel },
  { label: "GitHub", href: CONTACT.github },
  { label: "LinkedIn", href: CONTACT.linkedin },
  { label: "RSS", href: "/rss.xml" },
];
---

<footer class="mt-24 border-t border-border">
  <div
    class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-4 py-6 font-mono text-xs text-muted-foreground"
  >
    <span>© {year} {copy.name}</span>
    <nav aria-label={copy.social} class="flex flex-wrap gap-5">
      {
        links.map(link => (
          <a
            href={link.href}
            target={link.href.startsWith("http") ? "_blank" : undefined}
            rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
            class="transition-colors hover:text-acc"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <span>
      {copy.localTime} <time data-clock class="tabular-nums text-foreground">--:--</time> UTC+5
    </span>
  </div>
</footer>

<script>
  import { onPage } from "@/lib/page-lifecycle";

  // Shows Elyor's local time (UTC+5)
  onPage(() => {
    const clock = document.querySelector<HTMLTimeElement>("[data-clock]");
    if (!clock) return;
    const tick = () => {
      const now = new Date(Date.now() + 5 * 3600_000);
      clock.textContent = now.toISOString().slice(11, 16);
    };
    tick();
    const id = window.setInterval(tick, 15_000);
    return () => window.clearInterval(id);
  });
</script>
