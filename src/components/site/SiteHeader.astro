---
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";
import ThemeToggle from "@/components/theme/ThemeToggle.astro";
import { buildLangUrl, getLangFromUrl } from "@/i18n";
import { getSiteCopy } from "@/i18n/site";

const lang = getLangFromUrl(Astro.url);
const copy = getSiteCopy(lang);
const home = buildLangUrl("/", lang);
---

<!-- Keeps page content clear of the fixed bar -->
<div class="h-16 md:h-20" aria-hidden="true"></div>

<header
  id="header"
  class="pointer-events-none fixed inset-x-0 top-3 z-50 flex justify-center px-4"
>
  <div
    class="pointer-events-auto flex items-center gap-1.5 rounded-full border border-border bg-card/80 p-1.5 text-sm shadow-(--glass-shadow) backdrop-blur-md"
  >
    <a
      href={home}
      class="flex items-center gap-2 rounded-full px-2.5 py-1.5 font-semibold transition-colors hover:text-acc"
    >
      <span class="brand-dot h-2 w-2 rounded-full bg-acc" aria-hidden="true"></span>
      elyor.dev<span class="sr-only">, {copy.nav.home}</span>
    </a>

    <button
      type="button"
      data-open-cmdk
      class="hidden items-center gap-2 rounded-full border border-border px-3 py-1.5 transition-colors hover:border-acc sm:inline-flex"
    >
      {copy.search}
      <kbd data-kbd class="font-mono text-[11px] text-muted-foreground">Ctrl K</kbd>
    </button>

    <LanguageSwitcher />

    <ThemeToggle
      class="h-8 w-8 rounded-full border border-border transition-colors hover:border-acc"
      iconClass="h-4 w-4"
    />

    <button
      type="button"
      data-open-cmdk
      aria-haspopup="dialog"
      class="rounded-full bg-primary px-4 py-1.5 font-semibold text-primary-foreground transition-colors hover:bg-primary/90"
    >
      {copy.menu}
    </button>
  </div>
</header>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .brand-dot {
      animation: brand-pulse 2.4s ease-in-out infinite;
    }
  }
  @keyframes brand-pulse {
    50% {
      opacity: 0.35;
    }
  }
</style>
