---
// Place as early as possible in <head>. The site is dark by default through
// CSS alone, so nothing depends on this script running. When the visitor has
// picked light, it adds .light to <html> before first paint.
---

<meta name="color-scheme" content="dark" />
<script is:inline>
  (() => {
    const apply = () => {
      let light = false;
      try {
        light = localStorage.getItem("color-scheme") === "light";
        // Older versions pinned everyone to their first-visit theme
        localStorage.removeItem("theme");
      } catch {}

      const root = document.documentElement;
      root.classList.remove("dark");
      root.classList.toggle("light", light);
      const meta = document.querySelector('meta[name="color-scheme"]');
      if (meta) meta.content = light ? "light" : "dark";
    };

    apply();
    if (!window.__colorSchemeSwap) {
      window.__colorSchemeSwap = true;
      // Client-side navigations replace <html> attributes
      document.addEventListener("astro:after-swap", apply);
    }
  })();
</script>
