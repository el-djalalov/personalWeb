---
import { getLangFromUrl } from "@/i18n";
import { getSiteCopy } from "@/i18n/site";

interface Props {
  class?: string;
  iconClass?: string;
}

const { class: className, iconClass = "w-6 h-6" } = Astro.props;
const label = getSiteCopy(getLangFromUrl(Astro.url)).a11y.theme;
---

<button
  type="button"
  id="themeToggle"
  aria-label={label}
  aria-pressed="false"
  class:list={["flex items-center justify-center", className]}
>
  <svg
    class:list={[iconClass, "dark:hidden"]}
    aria-hidden="true"
    fill="none"
    stroke-linecap="round"
    stroke-linejoin="round"
    stroke-width="2"
    viewBox="0 0 24 24"
    stroke="currentColor"
    ><path
      d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
    ></path></svg
  >
  <svg
    class:list={[iconClass, "hidden dark:block"]}
    aria-hidden="true"
    fill="none"
    stroke-linecap="round"
    stroke-linejoin="round"
    stroke-width="2"
    viewBox="0 0 24 24"
    stroke="currentColor"
    ><path
      d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
    ></path></svg
  >
</button>

<script>
  // Dark is the default; the stored choice is "light" or "dark".
  const KEY = "color-scheme";
  const root = document.documentElement;
  type Scheme = "light" | "dark";

  const isDark = () => !root.classList.contains("light");

  function syncButtons() {
    const dark = isDark();
    document.querySelectorAll("#themeToggle").forEach(button => {
      button.setAttribute("aria-pressed", String(dark));
    });
  }

  function apply(scheme: Scheme) {
    root.classList.remove("dark");
    root.classList.toggle("light", scheme === "light");
    const meta = document.querySelector<HTMLMetaElement>(
      'meta[name="color-scheme"]',
    );
    if (meta) meta.content = scheme;
    syncButtons();
    // Canvas drawings read colors once; tell them the theme changed
    document.dispatchEvent(new CustomEvent("site:theme", { detail: scheme }));
  }

  // Grow the new theme out of the button, where the browser supports it
  function switchTo(scheme: Scheme, button: Element) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce || !document.startViewTransition) {
      apply(scheme);
      return;
    }
    const r = button.getBoundingClientRect();
    const x = r.left + r.width / 2;
    const y = r.top + r.height / 2;
    const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
    root.style.setProperty("--vt-x", `${x}px`);
    root.style.setProperty("--vt-y", `${y}px`);
    root.style.setProperty("--vt-r", `${radius}px`);
    root.classList.add("theme-switching");
    document
      .startViewTransition(() => apply(scheme))
      .finished.finally(() => root.classList.remove("theme-switching"));
  }

  // One delegated listener survives client-side navigations
  document.addEventListener("click", event => {
    const button = (event.target as Element).closest?.("#themeToggle");
    if (!button) return;
    const target: Scheme = isDark() ? "light" : "dark";
    try {
      localStorage.setItem(KEY, target);
    } catch {}
    switchTo(target, button);
  });

  // Stay in sync with changes made in other tabs
  window.addEventListener("storage", event => {
    if (event.key !== KEY && event.key !== null) return;
    apply(event.newValue === "light" ? "light" : "dark");
  });

  document.addEventListener("astro:page-load", syncButtons);
  syncButtons();
</script>
