---
import ThemeHead from "@/components/theme/ThemeHead.astro";
import SiteHeader from "@/components/site/SiteHeader.astro";
import BottomNav from "@/components/site/BottomNav.astro";
import SiteFooter from "@/components/site/SiteFooter.astro";
import CommandMenu from "@/components/site/CommandMenu.astro";
import { ClientRouter } from "astro:transitions";
import SpeedInsights from "@vercel/speed-insights/astro";
import "../styles/globals.css";
import type { Language } from "@/content.config";
import { SITE_URL, canonicalHref } from "@/lib/seo";
import { getPublicImageSize } from "@/utils/publicImageSize";

interface Props {
  title: string;
  // Title for link previews when it should differ from <title> (defaults to title)
  ogTitle?: string;
  description: string;
  image?: string;
  imageAlt?: string;
  canonicalUrl?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  modifiedTime?: Date;
  author?: string;
  tags?: string[];
  // Language of the page UI (sets <html lang>)
  lang?: Language;
}

const {
  title,
  ogTitle = title,
  description,
  image = "/og-image.png",
  imageAlt,
  canonicalUrl,
  type = "website",
  publishedTime,
  modifiedTime,
  author = "Elyor Djalalov",
  tags = [],
  lang = "en",
} = Astro.props;

const currentUrl = canonicalHref(canonicalUrl || Astro.url.pathname);
const ogImageUrl = new URL(image, SITE_URL).href;
// Real size of the share image; undefined for remote images, so no size is claimed
const ogImageSize = await getPublicImageSize(image);
---

<html lang={lang} transition:animate="initial">
  <head>
    <title>{title}</title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <ThemeHead />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    {tags.length > 0 && <meta name="keywords" content={tags.join(", ")} />}
    <link rel="canonical" href={currentUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    {ogImageSize && (
      <>
        <meta property="og:image:width" content={String(ogImageSize.width)} />
        <meta property="og:image:height" content={String(ogImageSize.height)} />
      </>
    )}
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta property="og:site_name" content="Elyor Djalalov" />

    {type === "article" && (
      <>
        {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
        {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
        <meta property="article:author" content={author} />
        {tags.map((tag) => <meta property="article:tag" content={tag} />)}
      </>
    )}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={currentUrl} />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}

    <!-- RSS Feed -->
    <link rel="alternate" type="application/rss+xml" title="Elyor's Blog RSS Feed" href="/rss.xml" />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <slot name="head" />
    <ClientRouter fallback="animate" />
  </head>

  <body class="antialiased bg-background text-foreground w-full min-h-screen">
    <SiteHeader />
    <div transition:animate="fade">
      <slot />
    </div>
    <SiteFooter />
    <BottomNav />
    <CommandMenu />
    <script src="../assets/js/main.js"></script>
    <SpeedInsights />
  </body>
</html>
