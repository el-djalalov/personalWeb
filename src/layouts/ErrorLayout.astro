---
import ThemeHead from "@/components/theme/ThemeHead.astro";
import SiteHeader from "@/components/site/SiteHeader.astro";
import BottomNav from "@/components/site/BottomNav.astro";
import SiteFooter from "@/components/site/SiteFooter.astro";
import CommandMenu from "@/components/site/CommandMenu.astro";
import { ClientRouter } from "astro:transitions";
import { getLangFromUrl } from "@/i18n";
import "../styles/globals.css";

const lang = getLangFromUrl(Astro.url);
---

<html lang={lang}>
  <head>
    <title>404 · Elyor Djalalov</title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <ThemeHead />
    <meta name="description" content="Page not found" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <slot name="head" />
    <ClientRouter fallback="animate" />
  </head>

  <body class="antialiased bg-background text-foreground w-full min-h-screen">
    <SiteHeader />
    <main>
      <slot />
    </main>
    <SiteFooter />
    <BottomNav />
    <CommandMenu />
    <script src="../assets/js/main.js"></script>
  </body>
</html>
