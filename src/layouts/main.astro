---
import ThemeHead from "@/components/theme/ThemeHead.astro";
import Header from "../components/home/header.astro";
import SquareLines from "../components/home/square-lines.astro";
import { ClientRouter } from "astro:transitions";
import SpeedInsights from "@vercel/speed-insights/astro";
import Separator from "@/components/separator.astro";
import { getLangFromUrl, t, buildLangUrl } from "@/i18n";
import { SUPPORTED_LANGUAGES } from "@/content.config";
import "../styles/globals.css";

const lang = getLangFromUrl(Astro.url);
const canonicalUrl = new URL(buildLangUrl("/", lang), Astro.site).href;
// Social previews need absolute image URLs
const ogImageUrl = new URL("/og-image.png", Astro.site).href;
const ogTitle = `${t("meta.title", lang)} - ${t("hero.title", lang)}`;
---

<html lang={lang} transition:name="root" transition:animate="none">
  <head>
    <title>{t("meta.title", lang)}</title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <ThemeHead />
    <meta
      name="description"
      content={t("meta.description", lang)}
    />
    <meta name="author" content="Elyor Djalalov" />
    <meta
      name="keywords"
      content="Elyor Djalalov, Frontend Developer, React, Astro, Web Development, Portfolio"
    />

    <link rel="canonical" href={canonicalUrl} />
    {SUPPORTED_LANGUAGES.map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(buildLangUrl("/", l), Astro.site)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL("/", Astro.site)} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={t("meta.description", lang)} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Elyor Djalalov" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={t("meta.description", lang)} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <slot name="head" />
    <ClientRouter fallback="animate" />
  </head>

  <body class="antialiased bg-white dark:bg-slate-950 w-full overflow-x-hidden">
    <SquareLines />
    <Header />
    <main>
    <slot />
    <Separator text={t("section.experience", lang)} />
    <slot name="experience" />
    <Separator text={t("section.projects", lang)} />
    <slot name="projects" />
    <Separator text={t("section.blog", lang)} />
    <slot name="blog" />
    <Separator text={t("section.contact", lang)} />
    <slot name="contacts" />
    </main>
    <slot name="footer" />
    <script src="../assets/js/main.js"></script>
    <SpeedInsights />
  </body>
</html>
