---
export const prerender = true;
import type { GetStaticPaths } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import BlogCard from "@/components/blog/BlogCard.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import readingTime from "reading-time";
import { buildLangUrl, t } from "@/i18n";
import type { Language } from "@/content.config";

// A type alias (not an interface) so it fits Astro's props record type
type TagPageProps = {
  tag: string;
  posts: CollectionEntry<"blog">[];
};

export const getStaticPaths = (async () => {
  const posts = await getCollection("blog");
  const allTags = [...new Set(posts.flatMap(post => post.data.tags))].filter(
    tag => tag && tag.trim() !== "",
  );

  const languages: Language[] = ["uz", "ru"];
  const paths: { params: { lang: string; tag: string }; props: TagPageProps }[] = [];

  for (const lang of languages) {
    for (const tag of allTags) {
      paths.push({
        params: { lang, tag: tag.toLowerCase() },
        props: {
          tag,
          posts: posts
            .filter(
              post =>
                !post.data.draft &&
                post.data.tags
                  .map(t => t.toLowerCase())
                  .includes(tag.toLowerCase()),
            )
            .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
        },
      });
    }
  }

  return paths;
}) satisfies GetStaticPaths;

const { lang } = Astro.params as { lang: Language };
const { tag, posts } = Astro.props;

// Get all unique tags for filter
const allPosts = await getCollection("blog");
const allTags = [...new Set(allPosts.flatMap(post => post.data.tags))]
  .filter(tag => tag && tag.trim() !== "")
  .sort();

function getReadingTime(body: string): string {
  const stats = readingTime(body);
  return stats.text;
}
---

<BaseLayout
  title={`${tag} - ${t("blog.title", lang)} | ${t("meta.title", lang)}`}
  description={`${t("blog.description", lang)} - ${tag}`}
  lang={lang}
>
  <main class="max-w-6xl mx-auto px-4 py-8 pt-20">
    <!-- Header -->
    <header class="mb-12 text-center">
      <a
        href={buildLangUrl("/blog", lang)}
        class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-acc transition-colors mb-4 group"
      >
        <svg
          class="w-4 h-4 transition-transform group-hover:-translate-x-1"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 19l-7-7 7-7"></path>
        </svg>
        {t("blog.allPosts", lang)}
      </a>
      <h1
        class="text-4xl md:text-5xl font-bold text-foreground mb-4"
      >
        <span class="text-acc">#{tag}</span>
      </h1>
      <p class="text-lg text-muted-foreground">
        {posts.length}
        {posts.length === 1 ? t("blog.post", lang) : t("blog.posts", lang)} {t("blog.taggedWith", lang)} <span
          class="font-medium">{tag}</span
        >
      </p>
    </header>

    <!-- Tags filter -->
    <div class="mb-8">
      <div class="flex flex-wrap justify-center gap-2">
        <a
          href={buildLangUrl("/blog", lang)}
          class="px-4 py-2 text-sm font-medium rounded-full bg-secondary text-muted-foreground hover:bg-acc/10 hover:text-acc transition-colors"
        >
          {t("blog.allPosts", lang)}
        </a>
        {
          allTags.map(t => (
            <a
              href={buildLangUrl(`/blog/tag/${t.toLowerCase()}`, lang)}
              class:list={[
                "px-4 py-2 text-sm font-medium rounded-full transition-colors",
                t.toLowerCase() === tag.toLowerCase()
                  ? "bg-primary text-primary-foreground"
                  : "bg-secondary text-muted-foreground hover:bg-acc/10 hover:text-acc",
              ]}
            >
              #{t}
            </a>
          ))
        }
      </div>
    </div>

    <!-- Posts grid -->
    {
      posts.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {posts.map(post => (
            <BlogCard
              post={post}
              readingTime={getReadingTime(post.body || "")}
              lang={lang}
            />
          ))}
        </div>
      ) : (
        <div class="text-center py-20">
          <p class="text-muted-foreground">
            {t("blog.noPosts", lang)}
          </p>
        </div>
      )
    }
  </main>
</BaseLayout>
