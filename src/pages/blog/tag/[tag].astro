---
export const prerender = true;
import type { GetStaticPaths } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import BlogCard from "@/components/blog/BlogCard.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { buildLangUrl, t } from "@/i18n";
import type { Language } from "@/content.config";
import { hasTag, postCountWord, readTimeLabel, uniqueTags } from "@/lib/blog";

// A type alias (not an interface) so it fits Astro's props record type
type TagPageProps = {
  tag: string;
  posts: CollectionEntry<"blog">[];
  allTags: string[];
};

export const getStaticPaths = (async () => {
  // Same posts as /blog: English only, newest first. Tags that only
  // translated posts carry get no English page, so no page is empty.
  const posts = (await getCollection("blog"))
    .filter(post => !post.data.draft && post.data.lang === "en")
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  const allTags = uniqueTags(posts);
  return allTags.map(tag => ({
    params: { tag: tag.toLowerCase() },
    props: { tag, allTags, posts: posts.filter(post => hasTag(post, tag)) } satisfies TagPageProps,
  }));
}) satisfies GetStaticPaths;

const lang: Language = "en";
const { tag, posts, allTags } = Astro.props;
---

<BaseLayout
  title={`${tag} - ${t("blog.title", lang)} | ${t("meta.title", lang)}`}
  description={`${t("blog.description", lang)} - ${tag}`}
  lang={lang}
>
  <main class="max-w-6xl mx-auto px-4 py-8">
    <!-- Header -->
    <header class="mb-12 text-center">
      <a
        href={buildLangUrl("/blog", lang)}
        class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-acc transition-colors mb-4 group"
      >
        <svg
          class="w-4 h-4 transition-transform group-hover:-translate-x-1"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 19l-7-7 7-7"></path>
        </svg>
        {t("blog.allPosts", lang)}
      </a>
      <h1
        class="font-display text-4xl md:text-5xl font-bold tracking-tight text-foreground mb-4"
      >
        <span class="text-acc">#{tag}</span>
      </h1>
      <p class="text-lg text-muted-foreground">
        {posts.length}{" "}
        {postCountWord(posts.length, lang)} {t("blog.taggedWith", lang)} <span
          class="font-medium">{tag}</span
        >
      </p>
    </header>

    <!-- Tags filter -->
    <div class="mb-8">
      <div class="flex flex-wrap justify-center gap-2">
        <a
          href={buildLangUrl("/blog", lang)}
          class="px-4 py-2 text-sm font-medium rounded-full bg-secondary text-muted-foreground hover:bg-acc/10 hover:text-acc transition-colors"
        >
          {t("blog.allPosts", lang)}
        </a>
        {
          allTags.map(t => (
            <a
              href={buildLangUrl(`/blog/tag/${t.toLowerCase()}`, lang)}
              class:list={[
                "px-4 py-2 text-sm font-medium rounded-full transition-colors",
                t.toLowerCase() === tag.toLowerCase()
                  ? "bg-primary text-primary-foreground"
                  : "bg-secondary text-muted-foreground hover:bg-acc/10 hover:text-acc",
              ]}
            >
              #{t}
            </a>
          ))
        }
      </div>
    </div>

    <!-- Posts grid -->
    {
      posts.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {posts.map(post => (
            <BlogCard
              post={post}
              readingTime={readTimeLabel(post.body ?? "", lang)}
              lang={lang}
            />
          ))}
        </div>
      ) : (
        <div class="text-center py-20">
          <p class="text-muted-foreground">
            {t("blog.noPosts", lang)}
          </p>
        </div>
      )
    }
  </main>
</BaseLayout>
